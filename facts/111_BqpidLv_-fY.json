 "quiz_facts": [
  {
   "fact": "У 1648 годзе Багдан Хмяльніцкі знішчыў залогу Рэчы Паспалітай каля Мікіцінскай Сечы, што паклала пачатак Казацкай вайне.",
   "timecode": "01:41"
  },
  {
   "fact": "Першым вайскоўцам, які атрымаў званне «беларускі палкоўнік», стаў магілёўскі шляхціч Канстанцін Паклонскі у 1654 годзе.",
   "timecode": "05:10"
  },
  {
   "fact": "У XVII стагоддзі назва «Белая Русь» ужывалася пераважна да праваслаўных жыхароў Усходняй Беларусі, а ўсіх жыхароў ВКЛ звалі літвінамі.",
   "timecode": "05:31"
  },
  {
   "fact": "У 1658 годзе была падпісана Гадзяцкая дамова, па якой Украіна вярталася ў склад Рэчы Паспалітай як Вялікае Княства Рускае.",
   "timecode": "08:29"
  },
  {
   "fact": "Андрусаўскае перамір'е 1667 года завершыла 13-гадовую вайну, па яе выніках ВКЛ страціла Смаленшчыну.",
   "timecode": "11:42"
  }
 ],
