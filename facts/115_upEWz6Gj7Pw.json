 "quiz_facts": [
  {
   "fact": "Найбольш прызнаная гіпотэза паходжання назвы «Русь» звязана з фінскім словам, якім называлі весляроў.",
   "timecode": "01:50"
  },
  {
   "fact": "Запрашэнне вікінгаў у 862 годзе стала паваротнай кропкай у развіцці гарадоў і ўлады на землях паміж Чорным і Балтыйскім морамі.",
   "timecode": "03:56"
  },
  {
   "fact": "Спачатку падзел на Вялікую і Малую Русь быў царкоўным: Вялікая Русь азначала Кіеўшчыну, а Малая — Галічыну і Літву.",
   "timecode": "05:48"
  },
  {
   "fact": "Тэрмін «Белая Русь» у другой палове XVI стагоддзя замацаваўся за тэрыторыяй Усходняй Беларусі.",
   "timecode": "06:44"
  },
